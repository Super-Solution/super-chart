{
  "name": "@supersolutions/super-chart-web",
  "version": "0.2.0",
  "description": "Canvas chart engine and workspace for the browser: drawing tools, replay, annotations and market overlays.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Super-Solution/super-chart.git",
    "directory": "packages/bindings/web"
  },
  "homepage": "https://github.com/Super-Solution/super-chart#readme",
  "bugs": {
    "url": "https://github.com/Super-Solution/super-chart/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./annotations": {
      "types": "./dist/annotations.d.ts",
      "import": "./dist/annotations.js"
    },
    "./overlays": {
      "types": "./dist/overlays.d.ts",
      "import": "./dist/overlays.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    }
  },
  "typesVersions": {
    "*": {
      "annotations": [
        "./dist/annotations.d.ts"
      ],
      "overlays": [
        "./dist/overlays.d.ts"
      ],
      "engine": [
        "./dist/engine.d.ts"
      ]
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "dependencies": {
    "@supersolutions/super-chart-core": "0.2.0"
  },
  "author": "SUPER SOLUTION LABS INC"
}
