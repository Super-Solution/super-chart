{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": false,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "src/index.ts",
    "src/core/index.ts",
    "src/native.ts",
    "src/superscript-entry.ts",
    "src/engine/indicatorCatalog.ts",
    "src/engine/scriptIndicators.ts",
    "src/engine/annotations.ts",
    "src/engine/overlayEntry.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
