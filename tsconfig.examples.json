{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "paths": {
      "@supersolutions/super-chart-core": [
        "packages/core/src/index.ts"
      ],
      "@supersolutions/super-chart-core/native": [
        "packages/core/src/native.ts"
      ],
      "@supersolutions/super-chart-core/indicators": [
        "packages/core/src/model/indicatorCatalog.ts"
      ],
      "@supersolutions/super-chart-superscript": [
        "packages/superscript/src/index.ts"
      ],
      "@supersolutions/super-chart-superscript/scripts": [
        "packages/superscript/src/scripts.ts"
      ],
      "@supersolutions/super-chart-web": [
        "packages/bindings/web/src/index.ts"
      ],
      "@supersolutions/super-chart-web/annotations": [
        "packages/bindings/web/src/annotations.ts"
      ],
      "@supersolutions/super-chart-web/overlays": [
        "packages/bindings/web/src/overlayEntry.ts"
      ],
      "@supersolutions/super-chart-chat-plugin": [
        "packages/integrations/chat-plugin/src/index.ts"
      ],
      "@supersolutions/super-chart-web/engine": [
        "packages/bindings/web/src/engine.ts"
      ],
      "@supersolutions/super-chart-react": [
        "packages/bindings/react/src/index.ts"
      ]
    }
  },
  "include": [
    "examples/_shared/*.ts",
    "examples/playground/*.ts",
    "examples/vanilla/*.ts",
    "examples/react/*.tsx",
    "examples/workspace-persistence/persistence.ts"
  ]
}
