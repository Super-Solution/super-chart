{
 "version": 1,
 "note": "Requests both indicator servers (backends/go/server, backends/python) must refuse, with this HTTP status and error code. Run with MaxBars 4, MaxIndicators 2 and MaxBodyBytes 512.",
 "config": {
  "maxBars": 4,
  "maxIndicators": 2,
  "maxBodyBytes": 512
 },
 "refusals": [
  {
   "name": "not json",
   "body": "nope",
   "status": 400,
   "code": "invalid_request"
  },
  {
   "name": "trailing data",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"fn\":\"sma\"}]} {}",
   "status": 400,
   "code": "invalid_request"
  },
  {
   "name": "unknown member",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"fn\":\"sma\"}],\"extra\":1}",
   "status": 400,
   "code": "invalid_request"
  },
  {
   "name": "no indicators",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[]}",
   "status": 400,
   "code": "invalid_request"
  },
  {
   "name": "no bars",
   "body": "{\"indicators\":[{\"fn\":\"sma\"}]}",
   "status": 400,
   "code": "invalid_request"
  },
  {
   "name": "unknown fn",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"fn\":\"nope\"}]}",
   "status": 400,
   "code": "unknown_indicator"
  },
  {
   "name": "unknown param",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"fn\":\"sma\",\"params\":{\"length\":3}}]}",
   "status": 400,
   "code": "invalid_param"
  },
  {
   "name": "fractional bars",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"fn\":\"change\",\"params\":{\"len\":1.5}}]}",
   "status": 400,
   "code": "invalid_param"
  },
  {
   "name": "string param",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"fn\":\"sma\",\"params\":{\"len\":\"3\"}}]}",
   "status": 400,
   "code": "invalid_param"
  },
  {
   "name": "unknown input",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"fn\":\"sma\",\"inputs\":{\"x\":\"close\"}}]}",
   "status": 400,
   "code": "invalid_input"
  },
  {
   "name": "unknown source",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"fn\":\"sma\",\"inputs\":{\"src\":\"later\"}}]}",
   "status": 400,
   "code": "unknown_source"
  },
  {
   "name": "missing column",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"fn\":\"sma\",\"inputs\":{\"src\":\"open\"}}]}",
   "status": 400,
   "code": "missing_bars_field"
  },
  {
   "name": "missing required input",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"fn\":\"crossover\"}]}",
   "status": 400,
   "code": "missing_input"
  },
  {
   "name": "duplicate id",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"id\":\"a\",\"fn\":\"sma\"},{\"id\":\"a\",\"fn\":\"ema\"}]}",
   "status": 400,
   "code": "duplicate_id"
  },
  {
   "name": "id shadows a bar field",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"id\":\"close\",\"fn\":\"sma\"}]}",
   "status": 400,
   "code": "duplicate_id"
  },
  {
   "name": "bad id",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"id\":\"a b\",\"fn\":\"sma\"}]}",
   "status": 400,
   "code": "invalid_id"
  },
  {
   "name": "ambiguous source",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"id\":\"m\",\"fn\":\"macd\"},{\"fn\":\"sma\",\"inputs\":{\"src\":\"m\"}}]}",
   "status": 400,
   "code": "ambiguous_source"
  },
  {
   "name": "ragged columns",
   "body": "{\"bars\":{\"high\":[1,2],\"low\":[1]},\"indicators\":[{\"fn\":\"atr\"}]}",
   "status": 400,
   "code": "bars_length_mismatch"
  },
  {
   "name": "bars of the wrong type",
   "body": "{\"bars\":3,\"indicators\":[{\"fn\":\"sma\"}]}",
   "status": 400,
   "code": "invalid_bars"
  },
  {
   "name": "too many bars",
   "body": "{\"bars\":{\"close\":[1,2,3,4,5]},\"indicators\":[{\"fn\":\"sma\"}]}",
   "status": 413,
   "code": "too_many_bars"
  },
  {
   "name": "too many indicators",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"id\":\"a\",\"fn\":\"sma\"},{\"id\":\"b\",\"fn\":\"sma\"},{\"id\":\"c\",\"fn\":\"sma\"}]}",
   "status": 413,
   "code": "too_many_indicators"
  },
  {
   "name": "body too large",
   "body": "{\"bars\":{\"close\":[1,2,3,4]},\"indicators\":[{\"fn\":\"sma\"}],\"pad\":\"\"}",
   "status": 413,
   "code": "body_too_large"
  }
 ]
}
