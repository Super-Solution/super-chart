{
  "name": "@super-solution/super-chart",
  "version": "0.1.0",
  "description": "Super Chart — owned financial chart engine, Web workspace and renderer-independent React Native core.",
  "type": "module",
  "main": "./dist/super-chart.cjs",
  "module": "./dist/super-chart.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/super-chart.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/super-chart.cjs"
      }
    },
    "./package.json": "./package.json",
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "react-native": "./dist/native.js",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    },
    "./superscript": {
      "types": "./dist/superscript.d.ts",
      "import": "./dist/superscript.js",
      "default": "./dist/superscript.js"
    },
    "./indicators": {
      "types": "./dist/indicators.d.ts",
      "import": "./dist/indicators.js",
      "default": "./dist/indicators.js"
    },
    "./scripts": {
      "types": "./dist/scripts.d.ts",
      "import": "./dist/scripts.js",
      "default": "./dist/scripts.js"
    },
    "./annotations": {
      "types": "./dist/annotations.d.ts",
      "import": "./dist/annotations.js",
      "default": "./dist/annotations.js"
    },
    "./overlays": {
      "types": "./dist/overlays.d.ts",
      "import": "./dist/overlays.js",
      "default": "./dist/overlays.js"
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "native": [
        "./dist/native.d.ts"
      ],
      "superscript": [
        "./dist/superscript.d.ts"
      ],
      "indicators": [
        "./dist/indicators.d.ts"
      ],
      "scripts": [
        "./dist/scripts.d.ts"
      ],
      "annotations": [
        "./dist/annotations.d.ts"
      ],
      "overlays": [
        "./dist/overlays.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs/OWNED-API-MIGRATION.md",
    "docs/OWNED-ENGINE.md",
    "docs/OWNED-DRAWING-CATALOG.md",
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Super-Solution/super-chart.git"
  },
  "keywords": [
    "super-chart",
    "tradingview",
    "candlestick",
    "finance",
    "trading",
    "chart",
    "ai",
    "superscript"
  ],
  "author": "Super Solution",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build-core": "tsc && vite build && vite build --mode bundles",
    "build-dts": "dts-bundle-generator --config dts-bundle.config.json && node -e \"require('node:fs').copyFileSync('dist/index.d.ts', 'dist/index.d.cts')\"",
    "build": "npm run build-core && npm run build-dts && npm run check:package",
    "check:package": "node scripts/check-package.mjs --self-test && node scripts/check-package.mjs",
    "dev": "vite",
    "dev:preview": "vite --port 5173 --strictPort",
    "test": "vitest run",
    "lint": "node scripts/lint.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "dts-bundle-generator": "^7.2.0",
    "eslint": "^8.35.0",
    "eslint-config-standard-with-typescript": "^34.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.6.1",
    "eslint-plugin-promise": "^6.1.1",
    "typescript": "^4.9.5",
    "vite": "^4.1.1",
    "vitest": "^0.28.4"
  }
}
