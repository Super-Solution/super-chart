{
  "name": "@zzyzxlabs/super-chart",
  "version": "0.0.40",
  "description": "Super Chart — a TradingView-grade financial charting engine based on KLineChart, with built-in AI and the SuperScript indicator/strategy language. Maintained by ZzyzxLabs.",
  "type": "module",
  "main": "./dist/klinecharts-pro.cjs",
  "module": "./dist/klinecharts-pro.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/klinecharts-pro.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/klinecharts-pro.cjs"
      }
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "default": "./dist/lite.js"
    },
    "./superscript": {
      "types": "./dist/superscript.d.ts",
      "default": "./dist/superscript.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "default": "./dist/commands.js"
    },
    "./style.css": "./dist/klinecharts-pro.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "lite": [
        "./dist/lite.d.ts"
      ],
      "superscript": [
        "./dist/superscript.d.ts"
      ],
      "commands": [
        "./dist/commands.d.ts"
      ]
    }
  },
  "sideEffects": [
    "*.css",
    "./dist/klinecharts-pro.js",
    "./dist/klinecharts-pro.cjs",
    "./dist/klinecharts-pro.umd.js"
  ],
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Super-Solution/super-chart.git"
  },
  "keywords": [
    "super-chart",
    "klinecharts",
    "tradingview",
    "candlestick",
    "finance",
    "trading",
    "chart",
    "ai",
    "superscript"
  ],
  "author": "ZzyzxLabs (based on KLineChart Pro by liihuu, Apache-2.0)",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build-core": "tsc && vite build && vite build --mode bundles",
    "build-dts": "dts-bundle-generator --config dts-bundle.config.json && node -e \"require('node:fs').copyFileSync('dist/index.d.ts', 'dist/index.d.cts')\"",
    "build": "npm run build-core && npm run build-dts && npm run check:package",
    "check:package": "node scripts/check-package.mjs --self-test && node scripts/check-package.mjs",
    "dev": "vite",
    "dev:preview": "vite --port 5173 --strictPort",
    "test": "vitest run",
    "lint": "eslint --max-warnings 380 --ext .ts,.tsx src",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.6.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@types/testing-library__jest-dom": "^5.14.5",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "dts-bundle-generator": "^7.2.0",
    "eslint": "^8.35.0",
    "eslint-config-standard-with-typescript": "^34.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.6.1",
    "eslint-plugin-promise": "^6.1.1",
    "klinecharts": "9.8.12",
    "klinecharts-compat": "npm:klinecharts@9.7.2",
    "less": "^4.1.3",
    "less-loader": "^11.1.0",
    "solid-js": "^1.6.11",
    "typescript": "^4.9.5",
    "vite": "^4.1.1",
    "vite-plugin-solid": "^2.6.1",
    "vitest": "^0.28.4"
  },
  "peerDependencies": {
    "klinecharts": "^9.7.2"
  }
}
